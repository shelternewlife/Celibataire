    "1": "United States and Canada",
    "2": "All European countries, including multilingual and non-EU countries listed below"
  },
  "url_policy": {
    "pattern": "/{locale}/",
    "examples": [
      "/en-us/",
      "/en-ca/",
      "/fr-ca/",
      "/de-de/",
      "/fr-fr/",
      "/es-es/"
    ],
    "locale_identifier": "BCP 47 language-region tag; store hreflang in standard casing (for example en-US) and normalize URL path to lowercase (en-us).",
    "canonical": "Each translated page has a self-referencing canonical URL.",
    "hreflang": "Emit reciprocal hreflang links only among equivalent pages that are genuinely available in each locale; include x-default for the global language selector or default landing page.",
    "fallback": "Do not silently serve English or another language under a locale URL. Untranslated locales remain unpublished and absent from sitemaps.",
    "country_targeting": "A locale identifies language and regional presentation; it is not a claim that the app contains vacancies or supports hiring in that country."
  },
